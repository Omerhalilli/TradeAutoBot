# ==============================================================================
# MetaTrader 4 Telegram Bot & ZeroMQ Bridge Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials and settings:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual '.env' file or any credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials & Security
# ------------------------------------------------------------------------------
# Obtain your Bot Token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security: Comma-separated list of authorized Telegram User/Chat IDs
# Message @userinfobot (https://t.me/userinfobot) to get your numeric ID.
# Anyone not in this list will be rejected with an access-denied warning.
ALLOWED_CHAT_IDS=123456789

# Two-Factor Authentication (TOTP) for high-risk actions like /panic (true/false)
TELEGRAM_ENABLE_2FA=false

# ------------------------------------------------------------------------------
# 2. ZeroMQ High-Frequency Bridge Connection
# ------------------------------------------------------------------------------
# TCP address where MT4_ZeroMQ_Bridge EA listens (default: tcp://127.0.0.1:5555)
ZMQ_SERVER_URL=tcp://127.0.0.1:5555
ZMQ_TIMEOUT_MS=3000
ZMQ_RETRY_INTERVAL_SEC=5

# Optional: Path to MT4 Files directory (auto-detected across Windows & Wine if omitted)
# Windows example: C:\Users\<User>\AppData\Roaming\MetaQuotes\Terminal\<ID>\MQL4\Files
# Linux Wine example: /home/<user>/.wine/drive_c/users/<user>/AppData/Roaming/MetaQuotes/Terminal/<ID>/MQL4/Files
# MT4_FILES_DIR=

# ------------------------------------------------------------------------------
# 3. Economic Calendar & News Alerts
# ------------------------------------------------------------------------------
# Minutes before high-impact news to send Telegram alert
NEWS_REMINDER_LEAD_MINUTES=15

# Filter impacts: High, Medium, Low (comma-separated)
NEWS_IMPACT_FILTER=High,Medium

# User local timezone for schedule alerts (e.g. UTC, America/New_York, Europe/London, Asia/Baku)
USER_TIMEZONE=UTC

# MetaTrader broker server GMT offset in hours (typically 2 in winter, 3 in summer)
BROKER_GMT_OFFSET=3

# ------------------------------------------------------------------------------
# 4. Multi-Account Broker Profiles (Optional)
# ------------------------------------------------------------------------------
DEMO_ACCOUNT_NAME=Demo Account
DEMO_ACCOUNT_NUMBER=Demo Account
DEMO_ACCOUNT_SERVER=Broker-Demo
REAL_ACCOUNT_NAME=Real Account
REAL_ACCOUNT_NUMBER=Real Live
REAL_ACCOUNT_SERVER=Broker-Real

# ------------------------------------------------------------------------------
# 5. Risk Management & Prop-Firm Safeguards
# ------------------------------------------------------------------------------
MAX_ACCOUNT_RISK_PCT=2.0
MAX_DAILY_LOSS_PCT=4.0
MAX_TOTAL_DRAWDOWN_PCT=8.0
MAX_OPEN_POSITIONS=10
MAX_LOTS_PER_SYMBOL=5.0
MAX_TOTAL_LOTS=15.0
ENABLE_TRAILING_STOP=true
DEFAULT_TRAILING_PIPS=20
ENABLE_BREAKEVEN=true
BREAKEVEN_TRIGGER_PIPS=15
BREAKEVEN_LOCK_PIPS=1

# ------------------------------------------------------------------------------
# 6. Strategy Parameters
# ------------------------------------------------------------------------------
TRADING_SYMBOLS=GBPUSD,EURUSD,XAUUSD,USOIL,USDJPY
TRADING_TIMEFRAMES=M5,M15,H1,H4
DEFAULT_SIZING_METHOD=volatility_atr
DEFAULT_FIXED_LOT=0.05

# ------------------------------------------------------------------------------
# 7. System & Logging
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
